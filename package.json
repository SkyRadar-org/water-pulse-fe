{
  "name": "skyradar-water-pulse",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "mock": "node scripts/make-mock.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "build:cloudflare": "node scripts/build-cloudflare.mjs",
    "dev:cloudflare": "wrangler pages dev dist --port 8788",
    "deploy:cloudflare": "wrangler pages deploy dist --project-name nisar-flood",
    "test:cloudflare": "node --test tests/cloudflare-worker.test.mjs",
    "test:ux": "node --experimental-strip-types --test tests/observations.test.mjs tests/reportStats.test.mjs tests/validationStats.test.mjs"
  },
  "dependencies": {
    "chart.js": "^4.6.1",
    "chartjs-adapter-date-fns": "^3.0.0",
    "date-fns": "^4.4.0",
    "maplibre-gl": "^6.4.1",
    "papaparse": "^5.7.1"
  },
  "devDependencies": {
    "@types/geojson": "^7946.0.16",
    "@types/papaparse": "^5.5.2",
    "pngjs": "^7.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "wrangler": "4.162.0"
  }
}
